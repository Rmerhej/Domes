# Copie ce fichier en ".env" (même dossier) pour docker compose.
# Le fichier .env est ignoré par Git.

# Mot de passe de la base MySQL Docker : choisis-en un (obligatoire)
DB_PASSWORD=

# Optionnel : envoi des mails "Nous contacter" (mot de passe d'application Google)
MAIL_USERNAME=
MAIL_PASSWORD=
